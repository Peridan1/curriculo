{
    "css.lint.unknownAtRules": "ignore",
    "cSpell.language": "en,pt,pt-BR",
    "cSpell.customDictionaries": {
        "project-words": {
            "name": "project-words",
            "path": "${workspaceFolder}/.vscode/custom-dictionary.txt",
            "addWords": true,
            "scope": "workspace"
        }
    },
    "cSpell.ignorePaths": [
        "node_modules/**",
        ".next/**",
        "package-lock.json",
        ".git/**"
    ]
}
