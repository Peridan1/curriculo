{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en,pt,pt-BR",
    "dictionaries": [
        "project-words"
    ],
    "dictionaryDefinitions": [
        {
            "name": "project-words",
            "path": "./.vscode/custom-dictionary.txt",
            "addWords": true
        }
    ],
    "ignorePaths": [
        "node_modules/**",
        ".next/**",
        "package-lock.json",
        ".git/**"
    ]
}
