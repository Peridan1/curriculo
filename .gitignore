# =========================================
# IGNORAR ARQUIVOS - PROJETO CURRÍCULO NEXT.JS
# =========================================

# Dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compilação e Build do Next.js
/.next/
/out/
/build/
/dist/

# Testes e Cobertura
/coverage/

# Variáveis de Ambiente (Ignorar arquivos locais com segredos, permitir .env.example)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs e Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Sistema Operacional e IDEs
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/custom-dictionary.txt
.idea/

# TypeScript Cache
*.tsbuildinfo

